# =====[Network Configuration]=====

# Use localhost when opening the dashboard on the same machine. For LAN access,
# set these to the host's reachable IP (e.g. http://192.168.1.50:3001).

# Internal HTTP configuration (VITE_BOT_URL and INTERNAL_HTTP_PORT must match)
VITE_BOT_URL=http://localhost:3001
INTERNAL_HTTP_PORT=3001

# Watchdog sidecar configuration (VITE_WATCHDOG_URL and WATCHDOG_HTTP_PORT must match)
VITE_WATCHDOG_URL=http://localhost:3002
WATCHDOG_HTTP_PORT=3002

# Static dashboard port
DASHBOARD_PORT=8080



# =====[Bot Configuration]=====

# Admin WhatsApp number without + or country code (e.g., 628123456789)
# used to receive notification from the bot number
ADMIN_NUMBER=

# OpenAI/Model Provider Configuration
# API key for your OpenAI-compatible service
OPENAI_API_KEY=
# Base URL for the model provider API (ex: http://host.docker.internal:20128/v1 for local base url)
OPENAI_BASE_URL=
# AI model name to use for message classification
AI_MODEL_NAME=



# =====[Cron Configuration]=====

# How often to process unsent messages (in minutes)
BATCH_FORWARD_INTERVAL_MINUTES=30
# How long to keep messages before deletion (in days, minimum 1)
CLEANUP_RETENTION_DAYS=7



# =====[Database Configuration]=====

# MySQL Configuration (for Docker)
# Database connection details
DATABASE_USER=autoforward
DATABASE_PASSWORD=autoforward_secure_password
DATABASE_NAME=autoforward
DATABASE_HOST=mysql
DATABASE_PORT=3306
# Full connection string (Docker will use mysql service name as host)
DATABASE_URL="mysql://autoforward:autoforward_secure_password@mysql:3306/autoforward"



# =====[Optional Changes]=====
# ONLY CHANGES NUMBER BELOW IF NEEDED

# Storage Configuration
# Directory path for storing JSON files
STORAGE_DIR=./storage
# Directory path for WhatsApp authentication state
AUTH_STATE_DIR=auth

# Cache Configuration (in seconds)
# Cache TTL for group metadata in CacheStorage
CACHE_TTL_SECONDS=300
# Cache TTL for group metadata in WASocket
GROUP_CACHE_TTL_SECONDS=900



# Debug logging (true to enable verbose debug logs in console / dashboard)
DEBUG=false